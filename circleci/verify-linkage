#!/bin/bash

# Verifies that a built docker image's entrypoint binary can start on the
# image's own runtime base:
#   1. load check: ldd resolves all shared libraries and glibc symbol
#      versions
#   2. exec check: the binary runs for up to 5s with no config and no
#      network without a crash signature (loader or architecture error,
#      panic during package init, native crash)
# Catches the case where a binary is compiled in a newer CI image than the
# Dockerfile's runtime base, which otherwise only fails at deploy time with
# e.g. "version `GLIBC_2.38' not found".
#
# Usage:
#
#   verify-linkage IMAGE
#
# Mode is read from CI_LINKAGE_CHECK:
#   warn    (default) print a warning on failure but exit 0
#   enforce exit 1 on failure
#   off     skip the check entirely
#
# The in-container check is kept in sync with
# internal/docker/linkage_check.sh (goci's copy of the same check).

set -e

IMAGE=$1
: ${IMAGE:?"Usage: verify-linkage IMAGE"}
MODE=${CI_LINKAGE_CHECK:-warn}

case "$MODE" in
  off)
    echo "Skipping linkage check (CI_LINKAGE_CHECK=off)"
    exit 0
    ;;
  warn|enforce) ;;
  *)
    echo "Invalid CI_LINKAGE_CHECK=$MODE, expected warn, enforce, or off"
    exit 1
    ;;
esac

# The binary docker would exec: the first Entrypoint element, falling
# back to the first Cmd element.
BIN=$(docker image inspect --format '{{if .Config.Entrypoint}}{{index .Config.Entrypoint 0}}{{else if .Config.Cmd}}{{index .Config.Cmd 0}}{{end}}' "$IMAGE")
if [ -z "$BIN" ]; then
  echo "Skipping linkage check: $IMAGE has no Entrypoint or Cmd"
  exit 0
fi

# Runs inside the image with the image's WORKDIR, so relative and $PATH
# entrypoints resolve the same way docker would resolve them. Exit 0 means
# pass or skip, exit 1 means the binary will not start.
read -r -d '' CHECK <<'EOF' || true
BIN="$1"
P=$(command -v "$BIN" 2>/dev/null) || { echo "FAIL: entrypoint $BIN not found in image"; exit 1; }
head -c 4 "$P" | grep -q ELF || { echo "SKIP: $P is not an ELF binary"; exit 0; }

# 1. Load check: every shared library and glibc symbol version resolves.
if command -v ldd >/dev/null 2>&1; then
  rc=0
  out=$(ldd "$P" 2>&1) || rc=$?
  echo "$out"
  case "$out" in
    *"not a dynamic executable"*|*"Not a valid dynamic program"*)
      echo "OK: $P is statically linked" ;;
    *)
      [ "$rc" -eq 0 ] || { echo "FAIL: ldd exited $rc for $P"; exit 1; }
      if echo "$out" | grep -q "not found"; then
        echo "FAIL: $P has unresolved shared libraries or symbol versions"; exit 1
      fi
      echo "OK: $P resolves all shared libraries against the runtime image" ;;
  esac
else
  echo "SKIP load check: no ldd in image"
fi

# 2. Exec check: start the binary with no config for a few seconds. Most
# services exit early complaining about missing config, which is fine.
# Fail only on signatures that mean the binary can never start: loader
# or architecture errors, a panic during package init, or a native crash.
command -v timeout >/dev/null 2>&1 || { echo "SKIP exec check: no timeout in image"; exit 0; }
rc=0
out=$(timeout 5 "$P" </dev/null 2>&1) || rc=$?
case "$rc" in
  124|143) echo "OK: $P was still running after 5s"; exit 0 ;;
esac
sig=""
case "$rc" in
  126|127) sig="could not be executed (exit $rc)" ;;
esac
if echo "$out" | grep -qiE "error while loading shared libraries|exec format error|cannot execute binary"; then
  sig="failed to load (wrong architecture or missing libraries)"
fi
if echo "$out" | grep -q "runtime.doInit"; then
  sig="panicked during package init, before main"
fi
if echo "$out" | grep -qE "SIGILL|illegal instruction|fatal error: unexpected signal"; then
  sig="crashed with a fatal signal"
fi
if [ -z "$sig" ] && [ "$rc" -gt 128 ]; then
  sig="was killed by signal $((rc - 128))"
fi
if [ -n "$sig" ]; then
  echo "$out" | tail -n 30
  echo "FAIL: $P $sig"
  exit 1
fi
echo "OK: $P exited $rc without a crash signature (expected without config)"
EOF

echo "Verifying $BIN in $IMAGE starts on the image's runtime base..."
rc=0
# --network none: the exec check starts the service binary.
docker run --rm --network none --entrypoint /bin/sh "$IMAGE" -c "$CHECK" linkage-check "$BIN" || rc=$?

# 126/127 come from docker itself when the image has no usable /bin/sh
# (e.g. scratch or distroless). Those images need static binaries anyway.
if [ "$rc" -eq 126 ] || [ "$rc" -eq 127 ]; then
  echo "Skipping linkage check: $IMAGE has no /bin/sh"
  exit 0
fi

if [ "$rc" -ne 0 ]; then
  if [ "$MODE" == "enforce" ]; then
    echo "Linkage check failed. The binary was likely built on a newer OS than the Dockerfile's runtime base."
    exit 1
  fi
  echo "WARNING: linkage check failed. This image will likely fail to start in production."
  echo "WARNING: this will fail the build once CI_LINKAGE_CHECK=enforce becomes the default."
fi
